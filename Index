    <!-- Pie de página -->
    <footer class="border-t border-gold-500/10 bg-dark-900 text-center py-6 text-xs text-gray-500">
        <p>© 2026 Excellence Group Ltd. Todos los derechos reservados.</p>
        <p class="mt-1 text-gold-500/40">Evidencia de Aprendizaje - Formulario & Validación con JavaScript</p>
    </footer>

    <!-- Lógica JavaScript de Validación e Interacción -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('jobApplicationForm');
            const formContainer = document.getElementById('formContainer');
            const summaryCard = document.getElementById('summaryCard');
            const btnNewForm = document.getElementById('btnNewForm');

            // Elementos de Entrada
            const inputNombre = document.getElementById('nombre');
            const inputEdad = document.getElementById('edad');
            const inputRfc = document.getElementById('rfc');
            const selectSucursal = document.getElementById('sucursal');

            // Convertir RFC a mayúsculas automáticamente durante la escritura
            inputRfc.addEventListener('input', function() {
                this.value = this.value.toUpperCase();
                validateRfcField();
            });

            // Validaciones dinámicas en eventos input / change
            inputNombre.addEventListener('input', validateNombreField);
            inputEdad.addEventListener('input', validateEdadField);
            selectSucursal.addEventListener('change', validateSucursalField);

            document.querySelectorAll('input[name="sexo"]').forEach(radio => {
                radio.addEventListener('change', validateSexoField);
            });

            document.querySelectorAll('input[name="habilidades"]').forEach(chk => {
                chk.addEventListener('change', validateHabilidadesField);
            });

            // Funciones de validación individuales
            function validateNombreField() {
                if (inputNombre.value.trim().length < 3) {
                    showError('nombre');
                    return false;
                }
                hideError('nombre');
                return true;
            }

            function validateEdadField() {
                const edadVal = parseInt(inputEdad.value, 10);
                if (isNaN(edadVal) || edadVal < 18 || edadVal > 99) {
                    showError('edad');
                    return false;
                }
                hideError('edad');
                return true;
            }

            function validateRfcField() {
                // Expresión regular oficial para RFC de Persona Física o Moral
                const rfcRegex = /^([A-Z&Ñ]{3,4})(\d{6})([A-Z0-9]{3})$/;
                if (!rfcRegex.test(inputRfc.value.trim())) {
                    showError('rfc');
                    return false;
                }
                hideError('rfc');
                return true;
            }

            function validateSucursalField() {
                if (!selectSucursal.value) {
                    showError('sucursal');
                    return false;
                }
                hideError('sucursal');
                return true;
            }

            function validateSexoField() {
                const sexoSelected = document.querySelector('input[name="sexo"]:checked');
                if (!sexoSelected) {
                    showError('sexo');
                    return false;
                }
                hideError('sexo');
                return true;
            }

            function validateHabilidadesField() {
                const habilidadesSelected = document.querySelectorAll('input[name="habilidades"]:checked');
                if (habilidadesSelected.length === 0) {
                    showError('habilidades');
                    return false;
                }
                hideError('habilidades');
                return true;
            }

            // Mostrar y Ocultar Errores
            function showError(field) {
                const errorEl = document.getElementById(`error-${field}`);
                if (errorEl) errorEl.classList.remove('hidden');
            }

            function hideError(field) {
                const errorEl = document.getElementById(`error-${field}`);
                if (errorEl) errorEl.classList.add('hidden');
            }

            // Manejador del Evento Submit con validación estricta
            form.addEventListener('submit', function(e) {
                e.preventDefault();

                const isNombreValid = validateNombreField();
                const isEdadValid = validateEdadField();
                const isRfcValid = validateRfcField();
                const isSucursalValid = validateSucursalField();
                const isSexoValid = validateSexoField();
                const isHabilidadesValid = validateHabilidadesField();

                const isFormValid = isNombreValid && isEdadValid && isRfcValid && isSucursalValid && isSexoValid && isHabilidadesValid;

                if (isFormValid) {
                    // Extraer los valores procesados
                    const nombre = inputNombre.value.trim();
                    const edad = inputEdad.value.trim();
                    const rfc = inputRfc.value.trim();
                    const sexo = document.querySelector('input[name="sexo"]:checked').value;
                    const sucursal = selectSucursal.value;
                    
                    const habilidades = Array.from(document.querySelectorAll('input[name="habilidades"]:checked'))
                        .map(cb => cb.value);

                    // Insertar datos en la sección de resumen
                    document.getElementById('res-nombre').textContent = nombre;
                    document.getElementById('res-edad').textContent = `${edad} años`;
                    document.getElementById('res-rfc').textContent = rfc;
                    document.getElementById('res-sexo').textContent = sexo;
                    document.getElementById('res-sucursal').textContent = sucursal;

                    const habContainer = document.getElementById('res-habilidades');
                    habContainer.innerHTML = '';
                    habilidades.forEach(hab => {
                        const badge = document.createElement('span');
                        badge.className = 'px-3 py-1 bg-gold-500/10 border border-gold-500/30 text-gold-300 rounded-full text-xs font-medium';
                        badge.textContent = hab;
                        habContainer.appendChild(badge);
                    });

                    // Ocultar el formulario y desplegar la tarjeta elegante de datos guardados
                    formContainer.classList.add('hidden');
                    summaryCard.classList.remove('hidden');
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            });

            // Reiniciar Formulario para nuevo registro
            btnNewForm.addEventListener('click', function() {
                form.reset();
                summaryCard.classList.add('hidden');
                formContainer.classList.remove('hidden');
            });
        });
    </script>
</body>
</html>
